# MarketMind Backend Environment Variables

# Gemini AI (System Default - fallback when user key not supplied)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase PostgreSQL (Optional: Falls back to local SQLite if not configured)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Security & Encryption (Master secret for encrypting user API keys at rest)
SECRET_KEY=marketmind_production_master_secret_key_change_in_prod

# Production CORS & Deployment
FRONTEND_URL=https://marketmind.vercel.app
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO

# Market Dynamics & Benchmarks
MARKET_TIMEZONE=Asia/Kolkata
SIGNIFICANT_MOVE_THRESHOLD=2.0
